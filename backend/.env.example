# Copy to backend/.env and fill in. NEVER commit .env.
# ENV: dev | test | prod   (prod disables /docs)
ENV=dev

# MongoDB Atlas — dedicated least-privilege user (readWrite on sehat_saathi only)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=sehat_saathi

# At least 32 random characters. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=<generate-a-long-random-secret>

# Comma-separated exact origins (no wildcard). Add your Vercel URL in production.
ALLOWED_ORIGINS=http://localhost:5173

# ---------------- LLM ----------------
# PROVIDER sets the default for both capabilities. "fake" = deterministic offline responses (no key needed).
PROVIDER=fake
# Override per capability if needed (vision needs an image-capable model):
# VISION_PROVIDER=gemini
# TEXT_PROVIDER=gemini

# Gemini (OpenAI-compatible endpoint). Check the current Flash model name in Google AI Studio.
# VISION_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# VISION_API_KEY=<your-gemini-key>
# VISION_MODEL=<gemini-flash-model-name>
# VISION_JSON_MODE=json_schema
# VISION_SUPPORTS_IMAGES=true
# TEXT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# TEXT_API_KEY=<your-gemini-key>
# TEXT_MODEL=<gemini-flash-model-name>
# TEXT_JSON_MODE=json_schema

# Other OpenAI-compatible providers (text) — examples:
# OpenRouter: TEXT_BASE_URL=https://openrouter.ai/api/v1      TEXT_JSON_MODE=json_object
# Groq:       TEXT_BASE_URL=https://api.groq.com/openai/v1     TEXT_JSON_MODE=json_object
# DeepSeek:   TEXT_BASE_URL=https://api.deepseek.com           TEXT_JSON_MODE=json_object

# LLM_TIMEOUT_SECONDS=45

# ---------------- LLM fallbacks (optional) ----------------
# Tried in order when the primary fails (rate limit / quota / outage / bad output).
# Each slot needs BASE_URL + API_KEY + MODEL, or none of them (startup fails on a half-filled slot).
# Vision fallbacks MUST be image-capable models. Whole chain: 50 s text, 100 s vision.
# TEXT_FALLBACK_1_PROVIDER=groq
# TEXT_FALLBACK_1_BASE_URL=https://api.groq.com/openai/v1
# TEXT_FALLBACK_1_API_KEY=<your-groq-key>
# TEXT_FALLBACK_1_MODEL=openai/gpt-oss-20b
# TEXT_FALLBACK_1_JSON_MODE=json_object
# TEXT_FALLBACK_2_PROVIDER=openrouter
# TEXT_FALLBACK_2_BASE_URL=https://openrouter.ai/api/v1
# TEXT_FALLBACK_2_API_KEY=<your-openrouter-key>
# TEXT_FALLBACK_2_MODEL=google/gemma-4-31b-it:free
# TEXT_FALLBACK_2_JSON_MODE=json_object
# VISION_FALLBACK_1_PROVIDER=openrouter
# VISION_FALLBACK_1_BASE_URL=https://openrouter.ai/api/v1
# VISION_FALLBACK_1_API_KEY=<your-openrouter-key>
# VISION_FALLBACK_1_MODEL=google/gemma-4-31b-it:free
# VISION_FALLBACK_1_JSON_MODE=json_object
# VISION_FALLBACK_2_PROVIDER=groq
# VISION_FALLBACK_2_BASE_URL=https://api.groq.com/openai/v1
# VISION_FALLBACK_2_API_KEY=<your-groq-key>
# VISION_FALLBACK_2_MODEL=qwen/qwen3.8-27b
# VISION_FALLBACK_2_JSON_MODE=json_object

# ---------------- Email codes via Brevo (optional) ----------------
# Email verification + "forgot password" (6-digit codes). Both or neither; the features are hidden
# when unset. EMAIL_FROM must be a sender verified in Brevo (Senders & IP -> Add a sender).
# Brevo -> SMTP & API -> API keys. Backend only: never put this key in the frontend.
# BREVO_API_KEY=<brevo-api-key-never-commit>
# EMAIL_FROM=<verified-sender@your-domain>
# EMAIL_FROM_NAME=Sehat Saathi

# ---------------- Vapi voice tools (optional) ----------------
# The web app binds each live Vapi call to the signed-in elder. /vapi/tools is OFF (503) until
# VAPI_WEBHOOK_SECRET is set (>= 32 random chars); configure the same value in Vapi as the
# X-Vapi-Secret header (or a bearer token) for the server URL.
# VAPI_WEBHOOK_SECRET=<generate-a-long-random-secret>
# VAPI_ASSISTANT_ID=<vapi-assistant-id>

# ---------------- Web Push (optional) ----------------
# Dose alarms when the app is closed + concern alerts to family/doctor. Both keys or neither.
# Generate: cd backend && .venv/Scripts/python -m scripts.gen_vapid https://<your-web-app>
# (writes the three lines below into .env and never prints the private key)
# VAPID_PUBLIC_KEY=<generated>
# VAPID_PRIVATE_KEY=<generated-never-commit>
# VAPID_SUBJECT=https://<your-web-app>
