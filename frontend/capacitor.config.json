{
  "appId": "com.sehatsathi.app",
  "appName": "Sehat Saathi",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "hostname": "sehat-saathi-delta.vercel.app"
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "backgroundColor": "#F3F2EE",
      "showSpinner": false,
      "androidScaleType": "CENTER_INSIDE",
      "launchShowDuration": 0
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_notify",
      "iconColor": "#2C5F51"
    }
  }
}